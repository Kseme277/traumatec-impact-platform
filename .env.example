# =============================================================================
# Traumatec Impact Platform — Microservices
# =============================================================================

POSTGRES_DB=tip
POSTGRES_USER=tip
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_PORT=5432

REDIS_PORT=6379
RQ_QUEUE_NAME=docgen

IDENTITY_PORT=8001
EVENTS_PORT=8002
CATALOG_PORT=8003
DOCGEN_PORT=8004

DATABASE_URL=postgresql+asyncpg://tip:change-me-in-production@postgres:5432/tip

IDENTITY_SERVICE_URL=http://identity:8001
EVENTS_SERVICE_URL=http://events:8002
CATALOG_SERVICE_URL=http://catalog:8003
DOCGEN_SERVICE_URL=http://docgen:8004

REDIS_URL=redis://redis:6379/0
CACHE_ENABLED=true
CACHE_TTL_SECONDS=900
CACHE_TTL_STATS_SECONDS=600
CACHE_TTL_CORRELATION_SECONDS=1800
STORAGE_ROOT=/app/storage

# --- MinIO (stockage documents) ---
STORAGE_BACKEND=minio
MINIO_ROOT_USER=tipminio
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET=tip-documents
MINIO_ENDPOINT=http://minio:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Intervalle du garbage collector MinIO (docgen-gc), en secondes — défaut 3600 (1 h)
STORAGE_GC_INTERVAL_SECONDS=3600

# --- Clerk (identity-service) — MÊME application que traumatec-guide-evens (GuideHub) ---
CLERK_SECRET_KEY=sk_test_REMPLACEZ_MOI
CLERK_JWKS_URL=https://champion-toucan-51.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://champion-toucan-51.clerk.accounts.dev

# --- Admin par défaut (créé au 1er démarrage identity) ---
BOOTSTRAP_ADMIN_EMAIL=admin@traumatec.org
BOOTSTRAP_ADMIN_NOM=Nkoa
BOOTSTRAP_ADMIN_PRENOM=Dominique
# Vide = Clerk crée + invite | Ou user_xxx si déjà créé dans Clerk
BOOTSTRAP_ADMIN_CLERK_ID=

CORS_ORIGINS=http://localhost:5173,http://localhost:8080,https://tip-platform.hopto.org
# IP LAN du poste TIP (accès depuis une autre machine) — complète CORS automatiquement
LAN_HOST=
# Si LAN_HOST est défini et APP_PUBLIC_URL pointe encore vers localhost, identity utilise l'IP LAN

# --- Emails (invitations : Clerk notify + copie SMTP si SMTP_ENABLED=true) ---
# Clerk Dashboard → Paths → Allowed redirect URLs (ajouter aussi http://<LAN_HOST>:5173/accept-invitation)
APP_PUBLIC_URL=https://tip-platform.hopto.org
# Console infra (Grafana, Prometheus, MinIO, cAdvisor) — https://tip-platform.hopto.org/infra/*
INFRA_BASIC_AUTH_USER=infra
INFRA_BASIC_AUTH_PASSWORD=changeme
# Console MinIO (port dédié nginx, sans sous-chemin)
MINIO_CONSOLE_PUBLIC_URL=https://tip-platform.hopto.org:3102
INVITATION_SMTP_FALLBACK=true
SMTP_ENABLED=false
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_FROM_EMAIL=noreply@traumatec.org
SMTP_FROM_NAME=Traumatec Impact Platform
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# Webhook Clerk (email.created) — voir docs/CONFIGURATION.md
CLERK_WEBHOOK_SECRET=

# --- Frontend (un seul fichier .env à la racine — pas de frontend/.env) ---
# Après modification d'une variable VITE_* : docker compose restart frontend (dev, pas de rebuild)
FRONTEND_PORT=5173
# Vide le catalogue au démarrage si true (importer manuellement les ZIP ensuite)
PACKAGE_BOOTSTRAP_DISABLED=true
VITE_API_PROXY_TARGET=direct
VITE_API_BASE_URL=/api
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REMPLACEZ_MOI
# Proxy same-origin Clerk (évite CORS en local) — à configurer aussi dans Clerk Dashboard → Domains
# Accès LAN (:5173) : ajouter http://<LAN_HOST>:5173 dans Clerk → Allowed origins
VITE_CLERK_PROXY_URL=/__clerk
VITE_CLERK_FRONTEND_API_URL=https://champion-toucan-51.clerk.accounts.dev
# Domaine primaire Clerk (TIP) — requis pour SSO satellite vers GuideHub
VITE_CLERK_DOMAIN=https://tip-platform.hopto.org
# GuideHub / evens — https://guidehub.hopto.org (API sur même origine /api/v1/)
# Portail TRAUMATEC : https://guidehub.hopto.org/traumatec-cm
# Handoff admin TIP : proxy nginx :3101 (HTTPS sur tip-platform.hopto.org)
VITE_GUIDES_URL=https://guidehub.hopto.org
VITE_GUIDES_API_URL=https://guidehub.hopto.org
VITE_GUIDES_HANDOFF_URL=https://tip-platform.hopto.org
VITE_GUIDES_COMPANY_SLUG=traumatec-cm
GUIDES_PROXY_PORT=3101
# Pont auth JWT GuideHub (identity-service → API /api/v1/auth/login)
GUIDES_BRIDGE_ENABLED=true
GUIDES_API_URL=https://guidehub.hopto.org
GUIDES_WEB_URL=https://guidehub.hopto.org
GUIDES_PROXY_WEB_URL=https://tip-platform.hopto.org
GUIDES_COMPANY_SLUG=traumatec-cm
GUIDES_BRIDGE_EMAIL=admin@traumatec.cm
GUIDES_BRIDGE_PASSWORD=change-me-guidehub-admin-password
# Slug / e-mail / mot de passe modifiables aussi dans Admin → Liaison GuideHub (priorité base)

# --- Assistant TIP (Mistral AI — https://console.mistral.ai/api-keys/) ---
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-2506
LLM_TIMEOUT=30

# --- Classification paquet (NVIDIA NIM — build.nvidia.com) ---
# Sans clé : règles métier (titre, activité, dates). Avec clé : Llama 3.3 70B via NIM.
# NVIDIA_API_KEY=nvapi-...
# NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_CLASSIFIER_MODEL=meta/llama-3.3-70b-instruct
# Modèle de repli si le principal est indisponible ou quota épuisé :
# NVIDIA_CLASSIFIER_FALLBACK_MODELS=meta/llama-3.1-70b-instruct
# NVIDIA_CLASSIFIER_TEMPERATURE=0.2
# NVIDIA_CLASSIFIER_TOP_P=0.7
# NVIDIA_CLASSIFIER_MAX_TOKENS=256

# --- Génération documentaire (docgen) ---
# Par défaut : règles métier rapides (pas d'appel NVIDIA à chaque génération).
# DOCGEN_GENERATION_USE_AI=1
# Analyse NVIDIA à l'import paquet (lent) — laisser vide ; les {{ … }} suffisent.
# Analyse IA Mistral à l'import ZIP (sinon scan rapide {{ }} uniquement). Peut aussi être activé via le switch UI.
# CATALOG_IMPORT_SCAN_USE_AI=true
# DOCGEN_FORCE_REANALYZE=1
# DOCGEN_ANALYSIS_DELAY=0.15
# Diagnostic quota NVIDIA : python3 scripts/check_nvidia_quota.py

# --- ONLYOFFICE (édition .doc / .docx dans le navigateur) ---
# ALLOW_PRIVATE_IP_ADDRESS via docker-compose (pas de local.json en :ro — casse le démarrage)
ONLYOFFICE_PORT=9980
# Navigateur :9980 direct, ou http://localhost:5173/onlyoffice via proxy Vite
ONLYOFFICE_PUBLIC_URL=http://localhost:9980
ONLYOFFICE_FILE_SECRET=change-me-onlyoffice-file-secret-min-32-chars

NGINX_PORT=8080

ZIP_NAME_PATTERN={project_number}_{event_name}_{city}_{country}_{date}
GENERATION_RETENTION_DAYS=365

# --- Observabilité (Prometheus + Grafana) ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=tip_grafana
GRAFANA_ADMIN_PASSWORD=change-me-grafana
CADVISOR_PORT=8089
