@startuml tip-use-case
!include ../_common.puml
left to right direction
skinparam nodesep 80
skinparam ranksep 75
skinparam usecase {
  BackgroundColor #EEF2FF
  BorderColor #334155
  FontSize 11
}

actor "Utilisateur interne" as USER <<abstract>>
actor "Support\nadministratif" as SA
actor "Contrôleur\nde procédure" as CP
actor "Validateur" as VAL
actor "Administrateur" as ADM

USER <|-- SA
USER <|-- CP
USER <|-- VAL
USER <|-- ADM

USER -[hidden]down- SA
SA -[hidden]down- CP
CP -[hidden]down- VAL
VAL -[hidden]down- ADM

rectangle "Traumatec Impact Platform (TIP)" as TIP {

  usecase "Consulter le\ntableau de bord" as UC01
  usecase "Gérer les\névénements" as UC02
  usecase "Importer le\nplan annuel" as UC03
  usecase "Importer les\nparticipants" as UC04

  usecase "S'authentifier" as UC00
  usecase "Générer le paquet\ndocumentaire" as UC05
  usecase "Télécharger\nle ZIP" as UC06
  usecase "Soumettre\nau contrôle" as UC07
  usecase "Contrôler le paquet" as UC08
  usecase "Valider\nle paquet" as UC09

  usecase "Gérer les templates\net types de paquet" as UC10
  usecase "Gérer les\nutilisateurs" as UC11
  usecase "Consulter\nl'audit" as UC12

  UC01 -[hidden]down- UC02
  UC02 -[hidden]down- UC03
  UC03 -[hidden]down- UC04

  UC01 -[hidden]right- UC00
  UC00 -[hidden]down- UC05
  UC05 -[hidden]down- UC07
  UC07 -[hidden]down- UC08
  UC08 -[hidden]down- UC09

  UC01 -[hidden]right- UC10
  UC10 -[hidden]down- UC11
  UC11 -[hidden]down- UC12

  UC05 -[hidden]right- UC06
}

USER --> UC00
USER --> UC01

SA --> UC02
SA --> UC04
SA --> UC05
SA --> UC07

CP --> UC08
VAL --> UC09

ADM --> UC03
ADM --> UC10
ADM --> UC11
ADM --> UC12

note top of UC00
  Tous les cas métier
  **<<include>>** S'authentifier
end note

UC05 ..> UC06 : <<include>>
UC03 ..> UC02 : <<extend>>
UC04 ..> UC02 : <<extend>>
UC07 ..> UC05 : <<extend>>
UC08 ..> UC07 : <<extend>>
UC09 ..> UC08 : <<extend>>

@enduml
