@startuml tip-use-case
!include ../_common.puml
left to right direction
skinparam nodesep 50
skinparam ranksep 45
skinparam usecase {
  BackgroundColor #EEF2FF
  BorderColor #334155
  FontSize 12
}

actor "Utilisateur interne" as USER <<abstract>>
actor "Support\nadministratif" as SA
actor "Contrôleur\nde procédure" as CP
actor "Validateur" as VAL
actor "Administrateur" as ADM

USER <|-- SA
USER <|-- CP
USER <|-- VAL
USER <|-- ADM

rectangle "Traumatec Impact Platform (TIP)" as TIP {

  usecase "S'authentifier" as UC00
  usecase "Consulter le\ntableau de bord" as UC01
  usecase "Gérer les événements" as UC02
  usecase "Importer participants\nou plan annuel" as UC03
  usecase "Générer le paquet\ndocumentaire" as UC04
  usecase "Contrôler et\nvalider le paquet" as UC05
  usecase "Administrer templates,\nutilisateurs et audit" as UC06
}

USER --> UC00
USER --> UC01

SA --> UC02
SA --> UC03
SA --> UC04

CP --> UC05
VAL --> UC05

ADM --> UC06

note bottom of TIP
  Chaque cas métier inclut
  l'authentification préalable
end note

@enduml
