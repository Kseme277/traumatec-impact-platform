@startuml tip-use-case
left to right direction
header \n
footer \n
skinparam shadowing false
skinparam backgroundColor white
skinparam actorStyle default
skinparam linetype polyline
skinparam wrapWidth 165
skinparam nodesep 55
skinparam ranksep 60
scale 1.25
skinparam ArrowColor #334155
skinparam ArrowThickness 1.1
skinparam rectangle {
  BorderColor #334155
  BackgroundColor #FFFFFF
  FontSize 16
  FontStyle bold
}
skinparam usecase {
  BackgroundColor #EEF2FF
  BorderColor #334155
  FontSize 13
}
skinparam actor {
  FontSize 13
}
skinparam note {
  BackgroundColor #FEF9C3
  BorderColor #CA8A04
  FontSize 11
}

actor "Utilisateur interne" as USER <<abstract>>
actor "Support administratif" as SA
actor "Contrôleur de procédure" as CP
actor "Validateur" as VAL
actor "Administrateur" as ADM

USER <|-- SA
USER <|-- CP
USER <|-- VAL
USER <|-- ADM

rectangle "Traumatec Impact Platform (TIP)" {
  usecase "S'authentifier" as UC00
  usecase "Consulter le tableau de bord" as UC01
  usecase "Accéder à GuideHub" as UC16
  usecase "Gérer la fiche événement" as UC02
  usecase "Importer le plan annuel" as UC03
  usecase "Télécharger le modèle Excel" as UC03a
  usecase "Importer les participants" as UC04
  usecase "Générer le paquet documentaire" as UC05
  usecase "Suivre le statut de génération" as UC05a
  usecase "Consulter l'historique des générations" as UC05b
  usecase "Télécharger le ZIP" as UC06
  usecase "Soumettre au contrôle" as UC07
  usecase "Contrôler le paquet" as UC08
  usecase "Valider le paquet" as UC09
  usecase "Gérer les templates de paquet" as UC10
  usecase "Gérer catégories et types de paquet" as UC13
  usecase "Gérer les utilisateurs" as UC11
  usecase "Inviter un utilisateur" as UC11a
  usecase "Gérer les référentiels" as UC14
  usecase "Consulter l'audit" as UC12
}

USER --> UC00
USER --> UC01

SA --> UC02
SA --> UC04
SA --> UC05
SA --> UC07

CP --> UC08

VAL --> UC09

ADM --> UC03
ADM --> UC10
ADM --> UC11
ADM --> UC12
ADM --> UC13
ADM --> UC14
ADM --> UC16

note right of UC00
  Tous les cas métier
  **<<include>>** S'authentifier
end note

UC01 ..> UC00 : <<include>>
UC16 ..> UC01 : <<extend>>
UC03 ..> UC02 : <<extend>>
UC03a ..> UC03 : <<extend>>
UC03a ..> UC04 : <<extend>>
UC04 ..> UC02 : <<extend>>
UC05a ..> UC05 : <<include>>
UC05b ..> UC05 : <<extend>>
UC06 ..> UC05 : <<include>>
UC07 ..> UC05 : <<extend>>
UC08 ..> UC07 : <<extend>>
UC09 ..> UC08 : <<extend>>
UC11a ..> UC11 : <<extend>>

@enduml
